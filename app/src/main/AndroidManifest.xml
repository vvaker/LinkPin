<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 查询可处理链接的全部已安装应用（自用 MVP，非商店分发） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 旧版桌面快捷方式降级 -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <!-- 仅用于展开 b23.tv 分享短链；展开失败时回退保存原始链接 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".LinkPinApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinkPin">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".routing.RouteActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.LinkPin.Transparent" />

        <!-- 系统分享「文本」目标：哔哩哔哩等 App 分享链接时直接保存到列表 -->
        <activity
            android:name=".share.ShareIntakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.LinkPin.Transparent"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
